APP_NAME="WpbotReserva"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Único entorno soportado: Docker (docker compose up -d). Los nombres de host
# de abajo son los nombres de servicio de docker-compose.yml, no localhost.
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=wpbotreserva
DB_USERNAME=wpbotreserva
DB_PASSWORD=wpbotreserva
# Solo la usa el contenedor mariadb para inicializar el usuario root — no es
# una credencial de la app.
DB_ROOT_PASSWORD=wpbotreserva_root

# Puerto del host donde nginx expone la app (http://localhost:${APP_PORT}).
APP_PORT=8000

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# En dev, docker-compose.override.yml levanta Mailpit (UI en :8025) — estos
# valores lo usan por defecto. En producción, reemplazar por un SMTP real.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@wpbotreserva.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Modelos disponibles por proveedor de IA (Parte I/config/ai.php). Las
# credenciales de WhatsApp/IA por negocio viven en la tabla `channels`
# (Parte XVI), no acá.
AI_MODELS_OPENAI=gpt-4o,gpt-4o-mini
AI_MODELS_GROK=grok-beta
AI_MODELS_GEMINI=gemini-2.5-flash,gemini-2.5-pro

# Retención de backups automáticos de MariaDB (Parte XV), en días.
BACKUP_RETENTION_DAYS=14

# Credenciales de IA de la propia plataforma (Hito 4, AiIntentClassifierStrategy)
# — distintas de las que cada negocio trae por su cuenta.
INTENT_CLASSIFIER_AI_PROVIDER=openai
INTENT_CLASSIFIER_AI_MODEL=gpt-4o-mini
INTENT_CLASSIFIER_AI_API_KEY=

# Ventana de deduplicación de mensajes entrantes por message_id (enmienda
# Hito 4, ProcessInboundConversationMessage) — valor conservador de partida,
# ajustar si se confirma la ventana real de reintento de webhooks de Meta.
CONVERSATION_MESSAGE_DEDUP_HOURS=48

VITE_APP_NAME="${APP_NAME}"
